CompileFlags:
  Add:
    # --- [ Padrão da Linguagem ] ---
    - "-std=gnu11"

    # --- [ Diagnósticos Base e Formatação ] ---
    - "-Wall"
    - "-Wextra"
    - "-Wpedantic"
    - "-Wshadow"
    - "-Wcast-align"
    - "-Wundef"
    - "-Wformat=2"
    - "-Werror=implicit-function-declaration"
    - "-Wnull-dereference"
    - "-Wwrite-strings"
    - "-Wswitch-enum"

    # --- [ Rigor de Protótipos e Escopo ] ---
    - "-Wstrict-prototypes"
    - "-Wmissing-prototypes"
    - "-Wmissing-declarations"
    - "-Wold-style-definition"
    - "-Wredundant-decls"

    # --- [ Segurança de Tipos, Ponteiros e Ponto Flutuante ] ---
    - "-Wconversion"
    - "-Wsign-conversion"
    - "-Wdouble-promotion"
    - "-Wcast-qual"
    - "-Wvla"
    - "-Wpointer-arith"
    - "-Wfloat-equal"
    - "-Wuninitialized"

    # --- [ Compatibilidade Limpa com Macros GLib / GTK3 sob -Wpedantic ] ---
    - "-Wno-overlength-strings"
    - "-Wno-gnu-zero-variadic-macro-arguments"

  Remove:
    # Filtra flags exclusivas do GCC que possam vir do compile_commands.json (bear)
    - "-Wduplicated-cond"
    - "-Wduplicated-branches"
    - "-Wstrict-aliasing=*"
    - "-Wlogical-op"

Diagnostics:
  UnusedIncludes: None

  ClangTidy:
    Add:
      # --- [ Prevenção de Bugs de Memória e Macros ] ---
      - "bugprone-sizeof-expression"
      - "bugprone-branch-clone"
      - "bugprone-suspicious-memory-comparison"
      - "bugprone-macro-parentheses"
      - "bugprone-unused-return-value"

      # --- [ Erros Lógicos Silenciosos e Matemática ] ---
      - "bugprone-integer-division"
      - "bugprone-narrowing-conversions"
      - "misc-definitions-in-headers"
      - "misc-redundant-expression"

      # --- [ Padronização, Leitura e Performance ] ---
      - "readability-inconsistent-declaration-parameter-name"
      - "readability-redundant-declaration"
      - "readability-braces-around-statements"
      - "performance-*"

    Remove:
      # --- [ Redução de Ruído ] ---
      - "readability-identifier-length"
      - "bugprone-easily-swappable-parameters"
      - "misc-unused-parameters"
      - "performance-no-int-to-ptr"
      - "bugprone-reserved-identifier"

---
# Silencia completamente o clang-tidy em arquivos gerados automaticamente pelo glib-compile-resources
If:
  PathMatch: .*recursos\.c
Diagnostics:
  Suppress: "*"
