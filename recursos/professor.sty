% --- DEPENDÊNCIAS ESSENCIAIS ---
% Agora o professor.sty centraliza a importação de todos os pacotes utilitários do Projeto Vértice
\RequirePackage[dvipsnames,table]{xcolor}
\RequirePackage{amsmath,amssymb}
\RequirePackage{multicol}
\RequirePackage{enumerate}
\RequirePackage[nointegrals]{wasysym}
\RequirePackage{bm}
\RequirePackage{array,multirow,graphicx}
\RequirePackage{setspace}
\RequirePackage{ulem}
\RequirePackage{type1cm}
\RequirePackage{fp} % Dependência para fixedpointarithmetic do TikZ
\RequirePackage{tikz}

% --- BIBLIOTECAS TIKZ ---
\usetikzlibrary{%
  shapes.geometric,%
  graphs,%
  calc,%
  arrows.meta,%
  intersections,%
  angles,%
  decorations.markings,%
  decorations.pathreplacing,%
  decorations.pathmorphing,%
  fixedpointarithmetic%
}

% --- DEFINIÇÃO DE CORES (ENSINO FUNDAMENTAL II) ---
\definecolor{LaranjaSexto}{cmyk}{0,0.60,1,0}   % 6º ANO
\definecolor{TurquesaSetimo}{HTML}{16A085}     % 7º ANO
\definecolor{RoxoOitavo}{HTML}{8E44AD}         % 8º ANO
\definecolor{GrafiteNono}{HTML}{2C3E50}        % 9º ANO

% --- DEFINIÇÃO DE CORES (ENSINO MÉDIO) ---
\definecolor{AzulProfessor}{HTML}{0055AA}      % 1º ANO
\definecolor{VerdeEscola}{HTML}{008844}        % 2º ANO
\definecolor{VinhoDestaque}{cmyk}{0,1,1,0.18}  % 3º ANO

% --- LÓGICA DE OPÇÕES DA SÉRIE ---
\DeclareOption{sexto}{\colorlet{CorSerie}{LaranjaSexto}}
\DeclareOption{setimo}{\colorlet{CorSerie}{TurquesaSetimo}}
\DeclareOption{oitavo}{\colorlet{CorSerie}{RoxoOitavo}}
\DeclareOption{nono}{\colorlet{CorSerie}{GrafiteNono}}
\DeclareOption{primeiro}{\colorlet{CorSerie}{AzulProfessor}}
\DeclareOption{segundo}{\colorlet{CorSerie}{VerdeEscola}}
\DeclareOption{terceiro}{\colorlet{CorSerie}{VinhoDestaque}}

\ExecuteOptions{primeiro} % Define "primeiro ano" como padrão de segurança
\ProcessOptions\relax

% --- PALETA DE CORES HARMONIZADA ---
\definecolor{VermelhoProva}{cmyk}{0,1,1,0.22}
\definecolor{Vinho}{cmyk}{0,1,1,0.45}
\definecolor{VermelhoLaser}{cmyk}{0,1,1,0}
\definecolor{VerdeSucesso}{RGB}{0,120,60}
\definecolor{LaranjaAlerta}{cmyk}{0,0.65,1,0.10}
\definecolor{RoxoElegante}{RGB}{100,50,150}
\definecolor{CinzaLinha}{rgb}{0.4,0.4,0.4}

% --- MACROS DE FORMATAÇÃO DE TABELAS (Migradas do Vértice em C) ---
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}
\newcommand*{\vtext}[2]{\parbox[t]{9pt}{\multirow{#1}{*}{\rotatebox[origin=c]{90}{#2}}}}

