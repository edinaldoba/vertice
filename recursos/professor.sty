% --- DEFINIÇÃO DE CORES (ENSINO FUNDAMENTAL II) ---
\definecolor{LaranjaSexto}{cmyk}{0,0.60,1,0}   % 6º ANO
\definecolor{TurquesaSetimo}{HTML}{16A085}     % 7º ANO
\definecolor{RoxoOitavo}{HTML}{8E44AD}         % 8° ANO
\definecolor{GrafiteNono}{HTML}{2C3E50}        % 9° ANO

% --- DEFINIÇÃO DE CORES (ENSINO MÉDIO) ---
\definecolor{AzulProfessor}{HTML}{0055AA}      % 1º ANO
\definecolor{VerdeEscola}{HTML}{008844}        % 2º ANO
\definecolor{VinhoDestaque}{cmyk}{0,1,1,0.18}  % 3° ANO

% --- LÓGICA DE OPÇÕES (A MÁGICA) ---
% Isso permite usar \usepackage[sexto]{professor}
\DeclareOption{sexto}{\colorlet{CorSerie}{LaranjaSexto}}
\DeclareOption{setimo}{\colorlet{CorSerie}{TurquesaSetimo}}
\DeclareOption{oitavo}{\colorlet{CorSerie}{RoxoOitavo}}
\DeclareOption{nono}{\colorlet{CorSerie}{GrafiteNono}}
\DeclareOption{primeiro}{\colorlet{CorSerie}{AzulProfessor}}
\DeclareOption{segundo}{\colorlet{CorSerie}{VerdeEscola}}
\DeclareOption{terceiro}{\colorlet{CorSerie}{VinhoDestaque}}

\ExecuteOptions{primeiro} % Define um padrão caso você não especifique
\ProcessOptions\relax

