% --- Nova Função para Questões Coloridas ---
% #1: Cor Principal (ex: AzulProfessor)
% #2: Cor do Texto/Ícone (ex: white para contraste ou o próprio AzulProfessor)
% #3: K (Ajuste de tamanho original)
% #4: Número da Questão (ex: 01, 02)
\newcommand{\questaoQuadradosColorida}[4]{%
	\pgfmathsetmacro{\k}{15*#3}
	\pgfmathsetmacro{\n}{10+\k}
	% Usamos a intensidade !10 para um fundo muito suave, igual ao circled
	\tikz[baseline=(char.base)]{
		% Caixa Principal com cantos arredondados, fundo suave e borda forte
		\node[
		shape=rectangle,
		rounded corners,
		draw=#1,             % Borda da Cor Principal
		fill=#1!10,          % Fundo Suave (10% da Cor Principal)
		align=center,
		inner sep=2pt,       % Mais respiro interno
		line width=1pt,      % Borda um pouco mais grossa
		font=\bf\small,
		text=#2              % Cor do texto interno
		] (char) {\hspace{1mm}\resizebox{2.6cm}{0.38cm}{QUEST\~AO #4}\hspace{1mm}};

		% Mini-Quadrados da Esquerda (Preenchimento suave, borda forte)
		\foreach \i in {0,...,2}{
			\draw[line width=0.8pt, color=#1, fill=#1!10]
			(-2.10+0.21*\i, -0.07) rectangle (-1.96+0.21*\i, +0.07);
		}

		% Mini-Quadrados da Direita (Preenchimento suave, borda forte)
		\foreach \i in {0,...,\n}{
			\draw[line width=0.8pt, color=#1, fill=#1!10]
			(1.54+0.21*\i, -0.07) rectangle (1.68+0.21*\i, +0.07);
		}

		% Linhas Laterais duplas (Cor forte)
		\draw[line width=0.8pt, color=#1]
		(-2.135,-0.14) -- (-1.47,-0.14) (1.475,-0.14) -- ({3.815+0.21*\k},-0.14)
		(-2.135,+0.14) -- (-1.47,+0.14) (1.475,+0.14) -- ({3.815+0.21*\k},+0.14);
	}
}







% --- Nova Função para Temas de Página (Ondas) ---
% #1: Cor Principal (ex: CorSerie)
% #2: K (Ajuste de comprimento extra)
\newcommand{\temaOndasColorida}[2]{%
	\begin{tikzpicture}[remember picture, overlay]
		% Cálculo da largura baseado no parâmetro #2
		\pgfmathsetmacro{\largura}{17.5 + 1.5*#2}
		\pgfmathsetmacro{\amostras}{20 * \largura}

		% --- Barra Superior ---
		\fill[#1!15] (0,0) rectangle (\largura, -0.28);
		% Sombra branca para a onda
		\draw[white, line width=2.8pt, smooth, samples=\amostras, domain=0:\largura]
		plot(\x, {-0.14 - 0.06*sin(12*\x r)});
		% Linha da onda na cor principal
		\draw[#1, line width=0.8pt, smooth, samples=\amostras, domain=0:\largura]
		plot(\x, {-0.14 - 0.06*sin(12*\x r)});

		% --- Barra Inferior (Espaçamento de 0.9 como no original) ---
		\fill[#1!15] (0,-1) rectangle (\largura, -1.28);
		% Sombra branca
		\draw[white, line width=2.8pt, smooth, samples=\amostras, domain=0:\largura]
		plot(\x, {-1.14 - 0.06*sin(12*\x r)});
		% Linha da onda
		\draw[#1, line width=0.8pt, smooth, samples=\amostras, domain=0:\largura]
		plot(\x, {-1.14 - 0.06*sin(12*\x r)});
	\end{tikzpicture}
}



% --- Modelo Ondas Aprimorado ---
% #1: Cor Principal (ex: blue, black, VerdeEscuro)
% #2: K (Ajuste de comprimento da barra)
% #3: Número da Questão
\newcommand{\questaoOndasColorida}[3]{%
	\noindent\tikz[baseline=(char.base)]{
		% O texto da Questão
		\node[inner sep=0pt, font=\bf\small, anchor=west] (char) at (0,0) {\resizebox{2.6cm}{0.38cm}{QUEST\~AO #3}\,\,};

		% Cálculo do comprimento da barra baseada no #2 (K)
		\pgfmathsetmacro{\larguraBarra}{3.2 + 3.25*#2}
		\pgfmathsetmacro{\amostras}{40 * \larguraBarra}

		% Retângulo de fundo (com tom suave da cor escolhida)
		\fill[#1!15] (2.7, -0.14) rectangle ({2.7 + \larguraBarra}, 0.14);

		% Onda Branca (para dar contraste/vazado)
		\draw[white, line width=2.8pt, smooth, samples=\amostras, domain=0:\larguraBarra]
		plot({\x+2.7}, {0.06*sin(12*\x r)});

		% Onda Colorida (a linha fina principal)
		\draw[#1, line width=0.8pt, smooth, samples=\amostras, domain=0:\larguraBarra]
		plot({\x+2.7}, {0.06*sin(12*\x r)});

		% Pontilhado decorativo inferior
		\pgfmathsetmacro{\numPontos}{59 + 32*#2}
		\foreach \i in {0,...,\numPontos}{
			\fill[#1!50] ({0.1*\i}, -0.35) circle (0.7pt);
		}
	}
}







\newcommand{\circledColorida}[3]{% #1: Cor, #2: Intensidade (0-100), #3: Texto
	\tikz[baseline=(char.base)]{
		\node[
		shape=circle,
		draw=#1,            % Cor da borda
		fill=#1!#2,         % Cor do fundo com intensidade
		line width=0.8pt,
		inner sep=1.5pt,
		font=\bf\small,
		text={% Lógica de contraste
			\ifnum#2>50 white\else black\fi
		}
		] (char) {#3};
	}
}


