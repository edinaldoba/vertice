% Nó circular
\newcommand{\circled}[2]{
\tikz[baseline=(char.base)]{
\pgfmathsetmacro{\g}{255*#1};
\pgfmathsetmacro{\gg}{255-\g};
\draw[line width=0.8pt, fill=gray!\g] (char) circle (0.18cm);
\node[inner sep=0pt, text=gray!\gg] (char) {\bf\small #2};
}
}







% #1: Cor Principal (ex: AzulProfessor)
% #2: Intensidade do preenchimento (ex: 10 ou 20)
% #3: Parâmetro original #2 (N)
\newcommand*{\temaQuadradosColorida}[2]{
	\pgfmathsetmacro{\n}{86}; % Número de quadrados
	\pgfmathsetmacro{\s}{(19)/(\n+1)-0.14};

	% Linhas horizontais principais na cor forte
	\draw[line width=1pt, color=#1] (0,0) -- (19,0)    (0,-0.28) -- (19,-0.28);
	\draw[line width=1pt, color=#1] (0,-1.00) -- (19,-1.00)    (0,-1.28) -- (19,-1.28);

	% Loop dos quadradinhos decorativos
	\foreach \i in {0,...,\n}{
		% Borda da cor principal e fundo suave
		\draw[line width=0.8pt, color=#1, fill=#1!#2]
		({0.5*\s+(0.14+\s)*\i}, -0.07) rectangle ({0.5*\s+0.14+(0.14+\s)*\i}, -0.21);

		\draw[line width=0.8pt, color=#1, fill=#1!#2]
		({0.5*\s+(0.14+\s)*\i}, -1.07) rectangle ({0.5*\s+0.14+(0.14+\s)*\i}, -1.21);
	}
}





