# ==============================================================================
# BLINDAGEM DE DADOS SENSÍVEIS, BANCO BINÁRIO E PRIVACIDADE
# ==============================================================================

# Ignora qualquer pasta chamada 'CE Poeta Cunha Santos' em qualquer profundidade/subpasta
config/*
**/CE Poeta Cunha Santos/

# Ignora assinaturas
.assinatura*
assinatura*

# Regras restritivas para suporte e acervo
acervo/*
!acervo/.gitkeep
suporte/*
!suporte/dependencias.sh

# Scripts locais
github.sh

# ==============================================================================
# PRODUTOS DE COMPILAÇÃO C / GTK / MAKEFILE
# ==============================================================================
# Executável compilado
vertice

# Objetos e dependências automáticas do GCC/Clang (-MMD -MP)
*.o
*.d
*.so
*.a
*.out
recursos.c

# Relatórios de análise de memória e diagnósticos
relatorio_valgrind.txt

# Arquivos temporários de editores (Kate, VSCode, Clangd)
.*.kate-swp
.clangd/
.cache/
compile_commands.json
compile_flags.txt

# ==============================================================================
# ARQUIVOS AUXILIARES DE COMPILAÇÃO LATEX / PDF
# ==============================================================================
*.aux
*.log
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Documentos finais gerados (PDFs e arquivos binários de alunos)
*.pdf
*.PDF
*.bin

# Backup compactado / Encriptado
*.tar.gz
*.tar.gz.gpg

# ==============================================================================
# IMAGENS E MÍDIAS (Ignora mídias locais de teste/scans OMR)
# ==============================================================================

# Regras globais de imagens
*.png
*.PNG
*.jpg
*.JPG
*.jpeg
*.JPEG
*.ppm
*.PPM
*.bmp
*.BMP
*.gif
*.GIF
*.svg
*.SVG
*.webp
*.WEBP
*.tiff
*.TIFF
