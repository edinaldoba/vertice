# =====================================================================
# SUPRESSÕES DO VALGRIND PARA GTK3, PANGO, POPPLER, OPENMP E GIO
# =====================================================================

{
   fontconfig_pattern_cache_alloc
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   fun:*alloc
   ...
   obj:*/libfontconfig.so*
}

{
   harfbuzz_shape_plan_cache
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   fun:calloc
   fun:hb_shape_plan_create*
   obj:*/libharfbuzz.so*
}

{
   pango_ft2_fontmap_cache
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/libpangoft2-1.0.so*
}

{
   pangocairo_font_map_default
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   fun:pango_cairo_font_map_get_default
}

{
   gtk3_css_and_style_cache
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/libgtk-3.so*
}

{
   gdk_pixbuf_loader_modules
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/libgdk_pixbuf-2.0.so*
}

{
   poppler_global_params_cache
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/libpoppler*.so*
}

{
   gio_gdbus_and_gvfs_worker_threads
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/libgio-2.0.so*
}

{
   gobject_type_registration_static
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   fun:g_type_register_*
   obj:*/libgobject-2.0.so*
}

{
   glib_charset_cache_omp
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   fun:g_get_charset
}

{
   glib_gslice_openmp_fork_shadow
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   fun:g_slice_alloc*
   fun:g_string_sized_new
}

{
   openmp_libgomp_thread_pool
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/libgomp.so*
}
